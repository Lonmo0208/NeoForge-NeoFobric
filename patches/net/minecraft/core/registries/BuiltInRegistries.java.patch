     private static void freeze() {
         REGISTRY.freeze();
 
+        // Neo: reopen the root registry right away. Vanilla freezes it to close the set of built-in
+        // registries, but that is not the state this game actually runs in: NeoForge reopens the root for
+        // NewRegistryEvent and never closes it again, and a mod is allowed to create its own registry on
+        // first use.
+        ((MappedRegistry<?>) REGISTRY).unfreeze(true);
+
         for (Registry<?> registry : REGISTRY) {
+            // NeoFobric: this method runs more than once in practice. Fabric's registry sync defers the
+            // whole bootStrap() to after mod initialization and runs it again, and NeoForge has already
+            // frozen the registries by then. Re-binding the bootstrapped tags of a closed registry would
+            // wipe the tags mod init just bound and throws "Registry is already frozen" out of
+            // validateWrite, so a registry that is closed already has nothing left to do here.
+            if (registry instanceof MappedRegistry<?> mappedRegistry && mappedRegistry.isFrozen()) {
+                continue;
+            }
             bindBootstrappedTagsToEmpty(registry);
             registry.freeze();
         }
